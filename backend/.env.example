# FinSense AI Backend Environment Variables Example
# Copy this file to .env in production

# Environment state: development, production
ENV=development

# Database configuration: defaults to SQLite for local development.
# In production, replace with your PostgreSQL URI (e.g. postgresql://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./finsense.db

# JWT settings
JWT_SECRET=supersecretkeychangeinproduction1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS configurations: comma-separated allowed origin domains
CORS_ORIGINS=http://localhost:3000

# Frontend domain URL (used for password reset/verification mailings)
FRONTEND_URL=http://localhost:3000

# OpenAI API Key (optional fallback is rule-based advisor)
OPENAI_API_KEY=
